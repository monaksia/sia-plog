{
  "name": "sia-plog",
  "version": "1.0.0",
  "description": "Personal photography, film reviews and reading archive",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:front": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build --configLoader runner",
    "start": "NODE_ENV=production node server/index.js",
    "setup": "node server/setup.js",
    "optimize-images": "node scripts/optimize-images.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "backup": "node scripts/backup.mjs",
    "verify-backup": "node scripts/verify-backup.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "vite": "^8.1.5"
  }
}
